<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/PrimaryBackgroundColor"
    tools:context=".ECGChart">

    <!--测量心电的界面-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">

        <!--左边框-->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:background="@drawable/shape" />

        <!--显示心电的可视化图像-->
        <LinearLayout
            android:layout_width="550dp"
            android:layout_height="match_parent"
            android:background="@color/GrayBackgroundColor">

            <USTB.AAIST.view.Wave
                android:id="@+id/waveShowView"
                android:layout_margin="2dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />
        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@drawable/shape" />

        <!--展示心电的具体数值-->
        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:divider="@color/black"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    app:cardBackgroundColor="@color/PredominantColor"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:id="@+id/HR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="HR"
                        android:textColor="@color/white"
                        android:textSize="20dp" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center">

                    <TextView
                        android:id="@+id/txtECG"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:text="000"
                        android:textAlignment="textEnd"
                        android:textColor="@color/ChartTxtColor"
                        android:textSize="30dp" />

                    <TextView
                        android:id="@+id/BMP"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_gravity="center"
                        android:text="BPM"
                        android:textAlignment="center"
                        android:textColor="@color/ChartTxtColor"
                        android:textSize="20dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="90dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!--分割线-->
            <View
                android:layout_marginTop="5dp"
                android:layout_marginLeft="2dp"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#dfdfdf" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="vertical">

                <Button
                    android:layout_marginTop="20dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:id="@+id/disconnect"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/buttonshape"
                    android:text="断开蓝牙"
                    android:textSize="15dp"
                    android:textColor="@color/white"/>

                <Button
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:id="@+id/OfflineData"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/buttonshape"
                    android:text="功能按钮"
                    android:textSize="15dp"
                    android:textColor="@color/white"/>

                <Button
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:id="@+id/OfflineView"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/buttonshape"
                    android:text="功能按钮"
                    android:textSize="15dp"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


