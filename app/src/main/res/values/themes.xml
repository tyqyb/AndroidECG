<!--可以先定义一个style，然后在这个style中设定每一个Activity或者整个App的颜色，最后在清单文件中来给某个Activity设置主题即可-->
        <style name="Theme.MainPage" parent="Theme.AppCompat.Light.DarkActionBar">
            <item name="colorPrimaryDark">@color/GrayBackgroundColor</item>
            <item name="android:statusBarColor">@color/GrayBackgroundColor</item>
            <item name="android:textColorPrimary">@color/gray</item>
        </style>

    <style name="Theme.SplashPage" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimaryDark">@color/PredominantColor</item>
        <item name="android:statusBarColor">@color/PredominantColor</item>
        <!--全屏显示-->
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.BlePage" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimaryDark">@color/PredominantColor</item>
        <item name="android:statusBarColor">@color/PredominantColor</item>
        <item name="android:textColorPrimary">@color/gray</item>
    </style>

