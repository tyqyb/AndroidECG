<resources xmlns:tools="http://schemas.android.com/tools">
<!--可以先定义一个style，然后在这个style中设定每一个Activity或者整个App的颜色，最后在清单文件中来给某个Activity设置主题即可-->
        <style name="Theme.MainPage" parent="Theme.AppCompat.Light.DarkActionBar">
            <item name="colorPrimaryDark">@color/GrayBackgroundColor</item>
            <item name="android:statusBarColor">@color/GrayBackgroundColor</item>
            <item name="android:textColorPrimary">@color/gray</item>
        </style>

    <style name="Theme.SplashPage" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="colorPrimaryDark">@color/PredominantColor</item>
        <item name="android:statusBarColor">@color/PredominantColor</item>
        <!--全屏显示-->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--无标题栏样式主题、全屏-->
    <style name="test" parent="Theme.AppCompat.Light.DarkActionBar">
            <!--全屏样式-->
        <item name="colorPrimary">#107C8A</item>
        <item name="colorPrimaryDark">#107C8A</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/GrayBackgroundColor</item>
        <item name="colorPrimaryVariant">@color/background</item>
        <item name="android:actionBarSize">40dp</item>
    </style>

</resources>